# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Keap/Infusionsoft (Service Account Key)
KEAP_SERVICE_ACCOUNT_KEY=xxx

# Keap Tag ID (MVP — single completion tag fires an automation that branches
# on worship_wheel_archetype into the right follow-up sequence)
KEAP_TAG_WW_COMPLETED=

# Keap Custom Field IDs
# KEAP_FIELD_WW_ARCHETYPE holds the stable snake_case key (decision-diamond routing);
# KEAP_FIELD_WW_ARCHETYPE_NAME holds the human display name without "The" (email merge fields);
# KEAP_FIELD_WW_RESULT_ID holds the bare result id for hyperlinkable results-URL merge fields
#   (https://worshipwheel.com/results/~Contact._worshipwheelresultid~).
# The _NAME and _RESULT_ID fields are optional in the sync — a missing value is skipped, not fatal.
KEAP_FIELD_WW_ARCHETYPE=
KEAP_FIELD_WW_ARCHETYPE_NAME=
KEAP_FIELD_WW_RESULTS_URL=
KEAP_FIELD_WW_RESULT_ID=
KEAP_FIELD_WW_OVERALL_SCORE=
KEAP_FIELD_WW_OVERALL_PERCENTAGE=

# Analytics
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_COOKIEBOT_ID=xxx

# App
NEXT_PUBLIC_BASE_URL=https://worshipwheel.com

# Admin Dashboard (spec 005)
# Single fixed timezone used for all dashboard day-boundaries and prior-period comparisons.
ADMIN_REPORTING_TIMEZONE=Africa/Johannesburg
# utm_source value that marks internal/self traffic so it can be excluded from metrics by default.
ADMIN_INTERNAL_UTM_SOURCE=internal
